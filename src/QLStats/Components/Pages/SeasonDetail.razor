@page "/seasons/{SeasonId:int}"
@rendermode InteractiveServer
@using QLStats.Data
@using QLStats.Data.Entities
@using QLStats.Services
@inject AppDbContext Db
@inject StandingsService StandingsService
@inject DuoAnalyticsService DuoService
@inject NavigationManager Nav

<PageTitle>Season — QL Stats</PageTitle>

@if (_season is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="d-flex align-center justify-space-between mb-2">
        <div>
            <MudText Typo="Typo.h4" Class="mb-1">@_season.Name</MudText>
            <MudText Color="Color.Secondary" Class="mb-4">
                @_season.StartDate — @(_season.EndDate?.ToString() ?? "ongoing")
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Nav.NavigateTo($"/seasons/{SeasonId}/edit"))">Edit Season</MudButton>
    </div>

    <MudText Typo="Typo.h6" Class="mb-2">Scoring Rules</MudText>
    <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
        <MudGrid>
            @foreach (var rule in _season.Rules.OrderBy(r => r.SortOrder))
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudText>• @rule.GetRuleDescription()</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

        @* ── Standings ──────────────────────────────────────────────────────── *@
        <MudTabPanel Text="Standings">
            @if (_standings.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No matches recorded for this season yet.</MudAlert>
            }
            else
            {
                <StandingsTable Standings="_standings" Season="_season" />
            }
        </MudTabPanel>

        @* ── Points History ──────────────────────────────────────────────────── *@
        <MudTabPanel Text="Points History" OnClick="LoadPointsHistory">
            @if (_pointsHistoryLoaded && _pointsHistory.Count > 0)
            {
                <div class="pa-4">
                    <MudChart ChartType="ChartType.Line" 
                              ChartSeries="@_series" 
                              XAxis="@_xAxisLabels" 
                              Width="100%" 
                              Height="350px"
                              ChartOptions="@_chartOptions" />
                </div>

                <MudTable Items="_pointsHistory" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Map</MudTh>
                        @foreach (var name in _pointsHistoryPlayers)
                        {
                            <MudTh>@name</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date</MudTd>
                        <MudTd>@context.Map</MudTd>
                        @foreach (var name in _pointsHistoryPlayers)
                        {
                            <MudTd>
                                @{
                                    var hasPts = context.CumulativePoints.TryGetValue(name, out var pts);
                                    var rankIdx = _pointsHistoryPlayers.IndexOf(name);
                                    decimal? gap = null;
                                    int? gapTrend = null;

                                    if (hasPts && rankIdx > 0)
                                    {
                                        var aboveName = _pointsHistoryPlayers[rankIdx - 1];
                                        if (context.CumulativePoints.TryGetValue(aboveName, out var abovePts))
                                        {
                                            gap = abovePts - pts;
                                            
                                            // Find previous gap for trend
                                            var rowIdx = _pointsHistory.IndexOf(context);
                                            if (rowIdx > 0)
                                            {
                                                var prevRow = _pointsHistory[rowIdx - 1];
                                                if (prevRow.CumulativePoints.TryGetValue(name, out var prevPts) &&
                                                    prevRow.CumulativePoints.TryGetValue(aboveName, out var prevAbovePts))
                                                {
                                                    var prevGap = prevAbovePts - prevPts;
                                                    if (gap < prevGap) gapTrend = -1; // Closing
                                                    else if (gap > prevGap) gapTrend = 1; // Widening
                                                }
                                            }
                                        }
                                    }
                                }
                                
                                <div class="d-flex flex-column">
                                    <strong>@(hasPts ? pts.ToString("0.##") : "—")</strong>
                                    @if (gap.HasValue)
                                    {
                                        <div class="d-flex align-center gap-1">
                                            <span style="font-size:0.75rem; color:var(--mud-palette-text-secondary)">Gap: @gap.Value.ToString("0.##")</span>
                                            @if (gapTrend == -1)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="Color.Success" Style="font-size:0.9rem" />
                                            }
                                            else if (gapTrend == 1)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Error" Style="font-size:0.9rem" />
                                            }
                                        </div>
                                    }
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            }
            else if (_pointsHistoryLoaded)
            {
                <MudAlert Severity="Severity.Info">Not enough match data yet.</MudAlert>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudTabPanel>

        @* ── Matches ─────────────────────────────────────────────────────────── *@
        <MudTabPanel Text="Matches" OnClick="LoadMatches">
            @if (_matchesLoaded && _seasonMatches.Count > 0)
            {
                <MudExpansionPanels Class="mt-2" Dense="true">
                    @foreach (var match in _seasonMatches)
                    {
                        <MudExpansionPanel>
                                                                <TitleContent>
                                                                    <div class="d-flex align-center gap-3 flex-wrap">
                                                                        <MudText><strong>@match.Map</strong></MudText>
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@match.Date</MudText>
                                                                        <MudText Typo="Typo.caption">
                                                                            <MudChip T="string" Color="Color.Error" Size="Size.Small">RED @match.RedScore</MudChip>
                                                                            –
                                                                            <MudChip T="string" Color="Color.Info" Size="Size.Small">BLUE @match.BlueScore</MudChip>
                                                                        </MudText>
                                                                        <div class="d-flex align-center ml-2">
                                                                            @foreach (var p in match.Players.OrderBy(x => x.Team == "BLUE"))
                                                                            {
                                                                                <MudText Typo="Typo.caption" Class="mr-2" Style="@($"color:{(p.Team == "RED" ? "var(--mud-palette-error)" : "var(--mud-palette-info)")}")">@p.Name</MudText>
                                                                            }
                                                                        </div>
                                                                        <MudIconButton Href="@($"/matches/{match.MatchId}")"
                                                                                       Icon="@Icons.Material.Filled.OpenInNew"
                                                                                       Size="Size.Small" />
                                                                    </div>
                                                                </TitleContent>                            <ChildContent>
                                <MudTable Items="match.Players" Dense="true" Elevation="0" Class="mx-2 mb-2">
                                    <HeaderContent>
                                        <MudTh>Player</MudTh>
                                        <MudTh>Team</MudTh>
                                        <MudTh>W/L</MudTh>
                                        <MudTh>K</MudTh>
                                        <MudTh>D</MudTh>
                                        <MudTh>K/D</MudTh>
                                        <MudTh>Dmg</MudTh>
                                        <MudTh>Dmg Taken</MudTh>
                                        <MudTh>Pts</MudTh>
                                        <MudTh>Gap</MudTh>
                                        <MudTh>Trend</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="p">
                                        <MudTd><strong>@p.Name</strong></MudTd>
                                        <MudTd>
                                            <MudChip T="string" Color="@(p.Team == "RED" ? Color.Error : Color.Info)" Size="Size.Small">@p.Team</MudChip>
                                        </MudTd>
                                        <MudTd>
                                            <MudChip T="string" Color="@(p.Won ? Color.Success : Color.Error)" Size="Size.Small">@(p.Won ? "W" : "L")</MudChip>
                                        </MudTd>
                                        <MudTd>@p.Kills</MudTd>
                                        <MudTd>@p.Deaths</MudTd>
                                        <MudTd>@(p.Deaths == 0 ? p.Kills.ToString() : ((double)p.Kills / p.Deaths).ToString("0.##"))</MudTd>
                                        <MudTd>@p.DamageDealt.ToString("N0")</MudTd>
                                        <MudTd>@p.DamageTaken.ToString("N0")</MudTd>
                                        <MudTd>
                                            <MudTooltip Text="@p.PointsBreakdown">
                                                <span style="color:@(p.Points > 0 ? "#4CAF50" : p.Points < 0 ? "#f44336" : "inherit"); font-weight:700">
                                                    @(p.Points > 0 ? "+" : "")@p.Points.ToString("0.##")
                                                </span>
                                            </MudTooltip>
                                        </MudTd>
                                        <MudTd>
                                            @{
                                                var idx = match.Players.IndexOf(p);
                                                if (idx > 0)
                                                {
                                                    var above = match.Players[idx - 1];
                                                    var gap = above.Points - p.Points;
                                                    <span style="font-size:0.85rem;color:var(--mud-palette-text-secondary)">-@gap.ToString("0.##")</span>
                                                }
                                            }
                                        </MudTd>
                                        <MudTd>
                                            @{
                                                var pIdx = match.Players.IndexOf(p);
                                                if (pIdx > 0)
                                                {
                                                    var currentP = p;
                                                    var aboveP = match.Players[pIdx - 1];
                                                    
                                                    var currentStandingsPlayer = _standings.FirstOrDefault(s => s.DisplayName == currentP.Name);
                                                    var aboveStandingsPlayer = _standings.FirstOrDefault(s => s.DisplayName == aboveP.Name);

                                                    if (currentStandingsPlayer != null && aboveStandingsPlayer != null)
                                                    {
                                                        var currentOverallGap = aboveStandingsPlayer.TotalPoints - currentStandingsPlayer.TotalPoints;
                                                        var lastOverallGap = aboveStandingsPlayer.LastTotalPoints - currentStandingsPlayer.LastTotalPoints;
                                                        
                                                        if (currentOverallGap < lastOverallGap)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="Color.Success" />
                                                        }
                                                        else if (currentOverallGap > lastOverallGap)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Error" />
                                                        }
                                                    }
                                                }
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
            else if (_matchesLoaded)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">No matches recorded for this season yet.</MudAlert>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudTabPanel>

        @* ── Top Duos ────────────────────────────────────────────────────────── *@
        <MudTabPanel Text="Top Duos" OnClick="LoadDuos">
            @if (_duosLoaded && _duos.Count > 0)
            {
                <MudTable Items="_duos" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Player 1</MudTh>
                        <MudTh>Player 2</MudTh>
                        <MudTh>Matches</MudTh>
                        <MudTh>Wins</MudTh>
                        <MudTh>Win Rate</MudTh>
                        <MudTh>Avg Kills</MudTh>
                        <MudTh>Avg Damage</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_duos.IndexOf(context) + 1)</MudTd>
                        <MudTd>@context.Player1Name</MudTd>
                        <MudTd>@context.Player2Name</MudTd>
                        <MudTd>@context.MatchesPlayed</MudTd>
                        <MudTd>@context.Wins</MudTd>
                        <MudTd>@context.WinRate%</MudTd>
                        <MudTd>@context.AvgKillsPerMatch</MudTd>
                        <MudTd>@context.AvgDamagePerMatch.ToString("N0")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (_duosLoaded)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">No duo data for this season yet.</MudAlert>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudTabPanel>

        @* ── Medals ──────────────────────────────────────────────────────────── *@
        <MudTabPanel Text="Medals" OnClick="LoadMedals">
            @if (_medalsLoaded && _medalRows.Count > 0)
            {
                <div style="overflow-x:auto" class="mt-2">
                    <MudTable T="MedalRow" Items="_medalRows" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>
                                <MudTableSortLabel T="MedalRow" SortBy="x => x.DisplayName">Player</MudTableSortLabel>
                            </MudTh>
                            @foreach (var medal in _medalNames)
                            {
                                <MudTh>@medal</MudTh>
                            }
                            <MudTh>
                                <MudTableSortLabel T="MedalRow" InitialDirection="SortDirection.Descending" SortBy="x => x.Total">Total</MudTableSortLabel>
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.DisplayName</strong></MudTd>
                            @foreach (var medal in _medalNames)
                            {
                                <MudTd>@(context.Medals.TryGetValue(medal, out var v) && v > 0 ? v.ToString() : "—")</MudTd>
                            }
                            <MudTd><strong>@context.Total</strong></MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
            else if (_medalsLoaded)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">No medal data recorded for this season yet.</MudAlert>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudTabPanel>

        @* ── Weapon Performance ──────────────────────────────────────────────── *@
        <MudTabPanel Text="Weapon Performance" OnClick="LoadWeaponStats">
            @if (_weaponStatsLoaded && _weaponRows.Count > 0)
            {
                <MudTable Items="_weaponRows" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Player</MudTh>
                        <MudTh>Top Weapon</MudTh>
                        <MudTh>Kills</MudTh>
                        <MudTh>All Weapons</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.DisplayName</MudTd>
                        <MudTd>@context.TopWeapon</MudTd>
                        <MudTd>@context.TopWeaponKills</MudTd>
                        <MudTd>
                            <MudTooltip>
                                <TooltipContent>
                                    @foreach (var kv in context.AllWeapons)
                                    {
                                        <div>@kv.Key: @kv.Value</div>
                                    }
                                </TooltipContent>
                                <ChildContent>
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </ChildContent>
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (_weaponStatsLoaded)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">No weapon data recorded for this season yet.</MudAlert>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudTabPanel>

    </MudTabs>
}

@code {
    [Parameter] public int SeasonId { get; set; }

    private QLStats.Data.Entities.Season? _season;
    private List<PlayerStanding> _standings = [];

    // Points history tab
    private bool _pointsHistoryLoaded;
    private record PointsHistoryRow(string Date, string Map, Dictionary<string, decimal> CumulativePoints);
    private List<PointsHistoryRow> _pointsHistory = [];
    private List<string> _pointsHistoryPlayers = [];
    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = Array.Empty<string>();
    private ChartOptions _chartOptions = new();

    // Matches tab
    private bool _matchesLoaded;
    private record SeasonMatchPlayerRow(string Name, string Team, bool Won, int Kills, int Deaths,
        int DamageDealt, int DamageTaken, decimal Points, string PointsBreakdown);
    private record SeasonMatchRow(int MatchId, string Map, string Date, int? RedScore, int? BlueScore,
        List<SeasonMatchPlayerRow> Players);
    private List<SeasonMatchRow> _seasonMatches = [];

    // Duos tab
    private bool _duosLoaded;
    private List<DuoStats> _duos = [];

    // Medals tab
    private bool _medalsLoaded;
    private record MedalRow(string DisplayName, Dictionary<string, int> Medals, int Total);
    private List<MedalRow> _medalRows = [];
    private List<string> _medalNames = [];

    // Weapon performance tab
    private bool _weaponStatsLoaded;
    private record WeaponRow(string DisplayName, string TopWeapon, int TopWeaponKills, Dictionary<string, int> AllWeapons);
    private List<WeaponRow> _weaponRows = [];

    protected override async Task OnInitializedAsync()
    {
        _season = await Db.Seasons.Include(s => s.Rules).FirstOrDefaultAsync(s => s.Id == SeasonId);
        if (_season is not null)
        {
            try { _standings = await StandingsService.GetSeasonStandingsAsync(SeasonId); }
            catch { _standings = []; }
        }
    }

    private (DateTime startDt, DateTime endDt) SeasonDateRange()
    {
        var startDt = DateTime.SpecifyKind(_season!.StartDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
        var endDt = _season.EndDate.HasValue
            ? DateTime.SpecifyKind(_season.EndDate.Value.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc)
            : DateTime.MaxValue;
        return (startDt, endDt);
    }

    private async Task LoadPointsHistory()
    {
        if (_pointsHistoryLoaded) return;

        var (startDt, endDt) = SeasonDateRange();

        var matchPlayers = await Db.MatchPlayers
            .Include(mp => mp.Player)
            .Include(mp => mp.Match)
            .Where(mp => mp.Match.StartedAt >= startDt && mp.Match.StartedAt < endDt
                         && mp.Match.FinishedAt != null && !mp.Match.IsArchived)
            .OrderBy(mp => mp.Match.StartedAt)
            .ToListAsync();

        if (matchPlayers.Count == 0)
        {
            _pointsHistoryLoaded = true;
            return;
        }

        var top5 = _standings.Take(5).ToList();
        _pointsHistoryPlayers = top5.Select(s => s.DisplayName).ToList();

        var cumulative = top5.ToDictionary(s => s.DisplayName, _ => (decimal)0);

        var byMatch = matchPlayers
            .GroupBy(mp => new { mp.MatchId, mp.Match.StartedAt, mp.Match.Map })
            .OrderBy(g => g.Key.StartedAt);

        foreach (var g in byMatch)
        {
            foreach (var mp in g)
            {
                var name = top5.FirstOrDefault(s => s.PlayerId == mp.PlayerId)?.DisplayName;
                if (name is null) continue;
                var (pts, _) = ScoringEngine.CalculatePointsWithBreakdown(mp, _season!);
                cumulative[name] += pts;
            }

            _pointsHistory.Add(new PointsHistoryRow(
                Date: g.Key.StartedAt.ToString("MM/dd HH:mm"),
                Map: g.Key.Map,
                CumulativePoints: new Dictionary<string, decimal>(cumulative)
            ));
        }

        // Prepare chart data
        _xAxisLabels = _pointsHistory.Select(x => x.Date).ToArray();
        _series = _pointsHistoryPlayers.Select(name => new ChartSeries<double>
        {
            Name = name,
            Data = _pointsHistory.Select(h => (double)h.CumulativePoints[name]).ToArray()
        }).ToList();

        _pointsHistoryLoaded = true;
    }

    private async Task LoadMatches()
    {
        if (_matchesLoaded) return;

        var (startDt, endDt) = SeasonDateRange();

        var matches = await Db.Matches
            .Include(m => m.MatchPlayers).ThenInclude(mp => mp.Player)
            .Where(m => m.StartedAt >= startDt && m.StartedAt < endDt && m.FinishedAt != null && !m.IsArchived)
            .OrderByDescending(m => m.StartedAt)
            .ToListAsync();

        _seasonMatches = matches.Select(m => new SeasonMatchRow(
            MatchId: m.Id,
            Map: m.Map,
            Date: m.StartedAt.ToString("MM/dd HH:mm"),
            RedScore: m.TeamRedRounds,
            BlueScore: m.TeamBlueRounds,
            Players: m.MatchPlayers
                .Select(mp =>
                {
                    var (pts, bd) = ScoringEngine.CalculatePointsWithBreakdown(mp, _season!);
                    return new SeasonMatchPlayerRow(
                        Name: mp.Player.DisplayName,
                        Team: mp.Team,
                        Won: mp.Won,
                        Kills: mp.Kills,
                        Deaths: mp.Deaths,
                        DamageDealt: mp.DamageDealt,
                        DamageTaken: mp.DamageTaken,
                        Points: pts,
                        PointsBreakdown: bd.Count > 0
                            ? string.Join(" | ", bd.Select(kv => $"{kv.Key}: {kv.Value:0.##}"))
                            : "No points"
                    );
                })
                .OrderByDescending(p => p.Points)
                .ToList()
        )).ToList();

        _matchesLoaded = true;
    }

    private async Task LoadDuos()
    {
        if (_duosLoaded) return;
        try { _duos = await DuoService.GetDuoStatsAsync(seasonId: SeasonId); }
        catch { _duos = []; }
        _duosLoaded = true;
    }

    private async Task LoadMedals()
    {
        if (_medalsLoaded) return;

        var (startDt, endDt) = SeasonDateRange();

        var matchPlayers = await Db.MatchPlayers
            .Include(mp => mp.Player)
            .Include(mp => mp.Match)
            .Where(mp => mp.Match.StartedAt >= startDt && mp.Match.StartedAt < endDt
                         && mp.Match.FinishedAt != null && !mp.Match.IsArchived)
            .ToListAsync();

        // All distinct medal types in this season, sorted alphabetically
        _medalNames = matchPlayers
            .SelectMany(mp => mp.Medals.Keys)
            .Distinct()
            .OrderBy(m => m)
            .ToList();

        // Aggregate medal counts per player
        _medalRows = matchPlayers
            .GroupBy(mp => new { mp.PlayerId, mp.Player.DisplayName })
            .Select(g =>
            {
                var medals = g
                    .SelectMany(mp => mp.Medals)
                    .GroupBy(kv => kv.Key)
                    .ToDictionary(mg => mg.Key, mg => mg.Sum(kv => kv.Value));
                return new MedalRow(g.Key.DisplayName, medals, medals.Values.Sum());
            })
            .Where(r => r.Total > 0)
            .OrderByDescending(r => r.Total)
            .ToList();

        _medalsLoaded = true;
    }

    private async Task LoadWeaponStats()
    {
        if (_weaponStatsLoaded) return;

        var (startDt, endDt) = SeasonDateRange();

        var matchPlayers = await Db.MatchPlayers
            .Include(mp => mp.Player)
            .Include(mp => mp.Match)
            .Where(mp => mp.Match.StartedAt >= startDt && mp.Match.StartedAt < endDt
                         && mp.Match.FinishedAt != null && !mp.Match.IsArchived
                         && mp.Weapons != null)
            .ToListAsync();

        _weaponRows = matchPlayers
            .GroupBy(mp => new { mp.PlayerId, mp.Player.DisplayName })
            .Select(g =>
            {
                var allWeapons = g
                    .SelectMany(mp => mp.Weapons)
                    .GroupBy(kv => kv.Key)
                    .ToDictionary(wg => wg.Key, wg => wg.Sum(kv => kv.Value));

                if (allWeapons.Count == 0)
                    return null;

                var top = allWeapons.MaxBy(kv => kv.Value);
                return new WeaponRow(
                    DisplayName: g.Key.DisplayName,
                    TopWeapon: top.Key,
                    TopWeaponKills: top.Value,
                    AllWeapons: allWeapons.OrderByDescending(kv => kv.Value).ToDictionary(kv => kv.Key, kv => kv.Value)
                );
            })
            .Where(r => r is not null)
            .Select(r => r!)
            .OrderByDescending(r => r.TopWeaponKills)
            .ToList();

        _weaponStatsLoaded = true;
    }
}
