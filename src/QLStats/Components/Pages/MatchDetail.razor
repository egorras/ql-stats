@page "/matches/{MatchId:int}"
@rendermode InteractiveServer
@using QLStats.Data
@using QLStats.Data.Entities
@using QLStats.Services
@inject AppDbContext Db
@inject StandingsService StandingsService
@inject StandingsNotifier StandingsNotifier

<PageTitle>Match Detail — QL Stats</PageTitle>

@if (_match is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_match.IsArchived)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            This match is archived and excluded from standings.
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleArchiveAsync">Unarchive</MudButton>
        </MudAlert>
    }

    <div class="d-flex align-center justify-space-between mb-1">
        <MudText Typo="Typo.h4">@_match.Map</MudText>
        @if (!_match.IsArchived)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Archive" Color="Color.Warning"
                           OnClick="() => _confirmOpen = true" />
        }
    </div>
    <MudText Color="Color.Secondary" Class="mb-4">
        @_match.StartedAt.ToString("yyyy-MM-dd HH:mm") · @_match.ServerTitle
    </MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Justify="Justify.Center">
            <MudItem>
                <MudText Typo="Typo.h3" Align="Align.Center">
                    <MudChip T="string" Color="Color.Error" Size="Size.Large">RED @_match.TeamRedRounds</MudChip>
                    <span Class="mx-3">–</span>
                    <MudChip T="string" Color="Color.Info" Size="Size.Large">BLUE @_match.TeamBlueRounds</MudChip>
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Error">RED Team</MudText>
            <MudTable Items="_redPlayers" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Player</MudTh>
                    <MudTh>W/L</MudTh>
                    <MudTh>K</MudTh>
                    <MudTh>D</MudTh>
                    <MudTh>K/D</MudTh>
                    <MudTh>Dmg</MudTh>
                    <MudTh>Weapons</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Player.DisplayName</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@(context.Won ? Color.Success : Color.Error)" Size="Size.Small">
                            @(context.Won ? "W" : "L")
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.Kills</MudTd>
                    <MudTd>@context.Deaths</MudTd>
                    <MudTd>@(context.Deaths == 0 ? context.Kills.ToString() : ((double)context.Kills / context.Deaths).ToString("0.##"))</MudTd>
                    <MudTd>@context.DamageDealt.ToString("N0")</MudTd>
                    <MudTd>
                        @if (context.Weapons.Count > 0)
                        {
                            <MudTooltip>
                                <TooltipContent>
                                    @foreach (var kv in context.Weapons.OrderByDescending(w => w.Value))
                                    {
                                        <div>@kv.Key: @kv.Value kills</div>
                                    }
                                </TooltipContent>
                                <ChildContent>
                                    <MudText Typo="Typo.caption">@GetTopWeapon(context.Weapons)</MudText>
                                </ChildContent>
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Info">BLUE Team</MudText>
            <MudTable Items="_bluePlayers" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Player</MudTh>
                    <MudTh>W/L</MudTh>
                    <MudTh>K</MudTh>
                    <MudTh>D</MudTh>
                    <MudTh>K/D</MudTh>
                    <MudTh>Dmg</MudTh>
                    <MudTh>Weapons</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Player.DisplayName</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@(context.Won ? Color.Success : Color.Error)" Size="Size.Small">
                            @(context.Won ? "W" : "L")
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.Kills</MudTd>
                    <MudTd>@context.Deaths</MudTd>
                    <MudTd>@(context.Deaths == 0 ? context.Kills.ToString() : ((double)context.Kills / context.Deaths).ToString("0.##"))</MudTd>
                    <MudTd>@context.DamageDealt.ToString("N0")</MudTd>
                    <MudTd>
                        @if (context.Weapons.Count > 0)
                        {
                            <MudTooltip>
                                <TooltipContent>
                                    @foreach (var kv in context.Weapons.OrderByDescending(w => w.Value))
                                    {
                                        <div>@kv.Key: @kv.Value kills</div>
                                    }
                                </TooltipContent>
                                <ChildContent>
                                    <MudText Typo="Typo.caption">@GetTopWeapon(context.Weapons)</MudText>
                                </ChildContent>
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>

        @if (_match.RoundResults.Count > 0)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Round Results</MudText>
                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                    @foreach (var r in _match.RoundResults.OrderBy(r => r.RoundNumber))
                    {
                        <MudChip T="string" Color="@(r.TeamWon == "RED" ? Color.Error : Color.Info)" Size="Size.Small">
                            R@(r.RoundNumber): @r.TeamWon
                        </MudChip>
                    }
                </div>
            </MudItem>
        }
    </MudGrid>
}

<MudDialog @bind-Visible="_confirmOpen">
    <TitleContent>Archive match</TitleContent>
    <DialogContent>
        Archive @(_match?.Map) (@(_match?.StartedAt.ToString("yyyy-MM-dd HH:mm")))?
        It will be excluded from standings and can be unarchived later.
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ToggleArchiveAsync">Archive</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int MatchId { get; set; }

    private Match? _match;
    private List<MatchPlayer> _redPlayers = [];
    private List<MatchPlayer> _bluePlayers = [];
    private bool _confirmOpen;

    protected override async Task OnInitializedAsync()
    {
        _match = await Db.Matches
            .Include(m => m.MatchPlayers).ThenInclude(mp => mp.Player)
            .Include(m => m.RoundResults)
            .Include(m => m.QLServer)
            .FirstOrDefaultAsync(m => m.Id == MatchId);

        if (_match is not null)
        {
            _redPlayers = _match.MatchPlayers.Where(mp => mp.Team == "RED").ToList();
            _bluePlayers = _match.MatchPlayers.Where(mp => mp.Team == "BLUE").ToList();
        }
    }

    private async Task ToggleArchiveAsync()
    {
        _confirmOpen = false;
        _match!.IsArchived = !_match.IsArchived;
        await Db.SaveChangesAsync();
        await StandingsService.SnapshotSeasonForMatchAsync(_match.StartedAt);
        StandingsNotifier.NotifyStandingsChanged();
    }

    private static string GetTopWeapon(Dictionary<string, int> weapons)
    {
        var top = weapons.MaxBy(kv => kv.Value);
        return $"{top.Key} ({top.Value})";
    }
}
