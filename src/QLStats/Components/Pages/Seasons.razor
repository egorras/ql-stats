@page "/seasons"
@using QLStats.Data
@using QLStats.Data.Entities
@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Seasons — QL Stats</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Seasons</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
    OnClick="@(() => Nav.NavigateTo("/seasons/new"))" Class="mb-4">New Season</MudButton>

<MudTable Items="_seasons" Dense="true" Hover="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Start</MudTh>
        <MudTh>End</MudTh>
        <MudTh>Active</MudTh>
        <MudTh>Matches</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudLink Href="@($"/seasons/{context.Id}")">@context.Name</MudLink>
        </MudTd>
        <MudTd>@context.StartDate</MudTd>
        <MudTd>@(context.EndDate?.ToString() ?? "—")</MudTd>
        <MudTd>
            @if (context.IsActive)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
            }
        </MudTd>
        <MudTd>@(_matchCounts.GetValueOrDefault(context.Id))</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => Nav.NavigateTo($"/seasons/{context.Id}/edit"))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Season> _seasons = [];
    private Dictionary<int, int> _matchCounts = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _seasons = await Db.Seasons.Include(s => s.Rules).OrderByDescending(s => s.IsActive).ThenByDescending(s => s.StartDate).ToListAsync();

        var allMatchDates = await Db.Matches
            .Where(m => m.FinishedAt != null)
            .Select(m => m.StartedAt)
            .ToListAsync();

        foreach (var s in _seasons)
        {
            var start = s.StartDate.ToDateTime(TimeOnly.MinValue);
            var end = s.EndDate.HasValue
                ? s.EndDate.Value.AddDays(1).ToDateTime(TimeOnly.MinValue)
                : DateTime.MaxValue;
            _matchCounts[s.Id] = allMatchDates.Count(d => d >= start && d < end);
        }

        _loading = false;
    }
}
