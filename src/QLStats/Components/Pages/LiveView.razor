@page "/live"
@rendermode InteractiveServer
@using QLStats.Services
@inject LiveMatchState LiveMatch
@implements IDisposable

<PageTitle>Live Match — QL Stats</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Live Match</MudText>

@if (_match is null)
{
    <MudAlert Severity="Severity.Info">No match currently in progress.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudGrid Justify="Justify.SpaceBetween" Style="align-items:center">
                        <MudItem>
                            <MudText Typo="Typo.h5">@_match.Map</MudText>
                            <MudText Color="Color.Secondary">@_match.ServerName · @_match.GameType</MudText>
                        </MudItem>
                        <MudItem>
                            <MudText Typo="Typo.h3" Align="Align.Center">
                                <MudChip T="string" Color="Color.Error" Size="Size.Large">RED @_match.RedScore</MudChip>
                                <span Class="mx-2">–</span>
                                <MudChip T="string" Color="Color.Info" Size="Size.Large">BLUE @_match.BlueScore</MudChip>
                            </MudText>
                            <MudText Align="Align.Center" Color="Color.Secondary">Round @_match.RoundNumber</MudText>
                        </MudItem>
                        <MudItem>
                            <MudText Color="Color.Secondary">Started @_match.StartedAt.ToString("HH:mm")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">Players</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_match.Players" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Player</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh>K</MudTh>
                            <MudTh>D</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@(context.Team == "RED" ? Color.Error : Color.Info)" Size="Size.Small">
                                    @context.Team
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.Kills</MudTd>
                            <MudTd>@context.Deaths</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">Kill Feed</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="max-height:400px;overflow-y:auto;">
                    @if (_match.KillFeed.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Waiting for kills...</MudText>
                    }
                    @foreach (var k in _match.KillFeed)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1">
                            <span style="color:var(--mud-palette-success)">@k.KillerName</span>
                            <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="mx-1" />
                            <span style="color:var(--mud-palette-error)">@k.VictimName</span>
                            <span Class="ml-1" style="color:var(--mud-palette-text-secondary)">[@k.Weapon]</span>
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private LiveMatchDto? _match;

    protected override void OnInitialized()
    {
        LiveMatch.OnMatchStateChanged += HandleStateChanged;
        _match = LiveMatch.Current;
    }

    private void HandleStateChanged()
    {
        _match = LiveMatch.Current;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => LiveMatch.OnMatchStateChanged -= HandleStateChanged;
}
