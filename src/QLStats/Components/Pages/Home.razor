@page "/"
@rendermode InteractiveServer
@using QLStats.Data
@using QLStats.Data.Entities
@using QLStats.Services
@inject AppDbContext Db
@inject StandingsService StandingsService
@inject DuoAnalyticsService DuoService
@inject StandingsNotifier StandingsNotifier
@inject LiveMatchState LiveMatch
@implements IDisposable

<PageTitle>Live — QL Stats</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Live</MudText>

@* ─── Live Match Header ────────────────────────────────────────────────── *@
@if (_liveMatch is not null)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid Justify="Justify.SpaceBetween" Style="align-items:center">
                <MudItem>
                    <MudText Typo="Typo.h5">@_liveMatch.Map</MudText>
                    <MudText Color="Color.Secondary">@_liveMatch.ServerName · @_liveMatch.GameType</MudText>
                </MudItem>
                <MudItem>
                    <MudText Typo="Typo.h4" Align="Align.Center">
                        <MudChip T="string" Color="Color.Error">RED @_liveMatch.RedScore</MudChip>
                        <span class="mx-2">–</span>
                        <MudChip T="string" Color="Color.Info">BLUE @_liveMatch.BlueScore</MudChip>
                    </MudText>
                    <MudText Align="Align.Center" Color="Color.Secondary">Round @_liveMatch.RoundNumber</MudText>
                </MudItem>
                <MudItem>
                    <MudText Color="Color.Secondary">Started @_liveMatch.StartedAt.ToString("HH:mm")</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@* ─── Season Summary Cards ─────────────────────────────────────────────── *@
@if (_activeSeason is not null && _standings.Count > 0)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Top Scorer</MudText>
                    <MudText Typo="Typo.body1"><strong>@(_standings.FirstOrDefault()?.DisplayName ?? "—")</strong></MudText>
                    <MudText Typo="Typo.caption">@(_standings.FirstOrDefault()?.TotalPoints.ToString("0.##") ?? "0") pts</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Success" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Best K/D (min 3 matches)</MudText>
                    <MudText Typo="Typo.body1"><strong>@(_bestKd?.DisplayName ?? "—")</strong></MudText>
                    <MudText Typo="Typo.caption">@(_bestKd is not null ? (_bestKd.Deaths == 0 ? _bestKd.Kills.ToString() : ((double)_bestKd.Kills / _bestKd.Deaths).ToString("0.##")) : "—")</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Error" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Most Damage</MudText>
                    <MudText Typo="Typo.body1"><strong>@(_mostDamage?.DisplayName ?? "—")</strong></MudText>
                    <MudText Typo="Typo.caption">@(_mostDamage?.DamageDealt.ToString("N0") ?? "0")</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Info" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Top Duo (min 3 matches)</MudText>
                    <MudText Typo="Typo.body1"><strong>@(_topDuo is not null ? $"{_topDuo.Player1Name} & {_topDuo.Player2Name}" : "—")</strong></MudText>
                    <MudText Typo="Typo.caption">@(_topDuo is not null ? $"{_topDuo.WinRate}% WR in {_topDuo.MatchesPlayed} matches" : "—")</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@* ─── Main Grid: Standings + Sidebar ──────────────────────────────────── *@
<MudGrid>
    <MudItem xs="12" md="8">
        @if (_activeSeason is not null && _standings.Count > 0)
        {
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@_activeSeason.Name — Standings</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_activeSeason.StartDate.ToString("MMM d, yyyy") –
                            @(_activeSeason.EndDate?.ToString("MMM d, yyyy") ?? "ongoing")
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Href="@($"/seasons/{_activeSeason.Id}")" Variant="Variant.Text">Full standings</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <div style="overflow-x:auto">
                        <MudTable Items="_standings" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Player</MudTh>
                                <MudTh>Pts</MudTh>
                                @if (_liveMatch is not null)
                                {
                                    <MudTh>
                                        <MudTooltip Text="Projected points in current match (excludes win/loss and damage bonuses)">
                                            Live Pts *
                                        </MudTooltip>
                                    </MudTh>
                                }
                                @foreach (var ruleName in _ruleNames)
                                {
                                    <MudTh>@ruleName</MudTh>
                                }
                                <MudTh>W</MudTh>
                                <MudTh>L</MudTh>
                                <MudTh>K</MudTh>
                                <MudTh>D</MudTh>
                                <MudTh>K/D</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@(_standings.IndexOf(context) + 1)</MudTd>
                                <MudTd>@context.DisplayName</MudTd>
                                <MudTd><strong>@context.TotalPoints.ToString("0.##")</strong></MudTd>
                                @if (_liveMatch is not null)
                                {
                                    <MudTd>
                                        <span class="live-pts-cell">
                                            @if (GetLiveProj(context.DisplayName) is { } proj)
                                            {
                                                <strong>@proj.EstimatedPoints.ToString("0.##")</strong>
                                            }
                                            else
                                            {
                                                <span style="color:var(--mud-palette-text-disabled)">—</span>
                                            }
                                            @if (GetActiveDelta(context.DisplayName) is { } delta)
                                            {
                                                <span @key="@($"{context.DisplayName}|{delta.At.Ticks}")"
                                                      class="pts-delta @(delta.Delta > 0 ? "pts-delta--pos" : "pts-delta--neg")">
                                                    @(delta.Delta > 0 ? "+" : "")@delta.Delta.ToString("0.##")
                                                </span>
                                            }
                                        </span>
                                    </MudTd>
                                }
                                @foreach (var ruleName in _ruleNames)
                                {
                                    <MudTd @key="ruleName">
                                        @if (context.RulesBreakdown.TryGetValue(ruleName, out var ruleVal))
                                        {
                                            @ruleVal.ToString("0.##")
                                        }
                                        else
                                        {
                                            <span style="color:var(--mud-palette-text-disabled)">—</span>
                                        }
                                    </MudTd>
                                }
                                <MudTd>@context.Wins</MudTd>
                                <MudTd>@context.Losses</MudTd>
                                <MudTd>@context.Kills</MudTd>
                                <MudTd>@context.Deaths</MudTd>
                                <MudTd>@(context.Deaths == 0 ? context.Kills.ToString() : ((double)context.Kills / context.Deaths).ToString("0.##"))</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                    @if (_liveMatch is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            * Live Pts: current match only. Win/loss and damage bonuses not included until match ends.
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
        else if (_activeSeason is null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                No active season. <MudLink Href="/seasons">Create one</MudLink>
            </MudAlert>
        }
    </MudItem>

    <MudItem xs="12" md="4">
        @if (_liveMatch is not null)
        {
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Class="mr-1" />
                            Kill Feed
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="max-height:350px;overflow-y:auto;">
                    @if (_liveMatch.KillFeed.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Waiting for kills...</MudText>
                    }
                    else
                    {
                        @foreach (var k in _liveMatch.KillFeed)
                        {
                            <MudText Typo="Typo.body2" Class="mb-1">
                                <span style="color:var(--mud-palette-success)">@k.KillerName</span>
                                <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="mx-1" />
                                <span style="color:var(--mud-palette-error)">@k.VictimName</span>
                                <span class="ml-1" style="color:var(--mud-palette-text-secondary)">[@k.Weapon]</span>
                            </MudText>
                        }
                    }
                </MudCardContent>
            </MudCard>
        }

        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Recent Matches</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Href="/matches" Variant="Variant.Text">All</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (_recentMatches.Count == 0)
                {
                    <MudText Color="Color.Secondary">No matches yet.</MudText>
                }
                @foreach (var m in _recentMatches)
                {
                    <MudPaper Class="pa-2 mb-2" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.body2">
                            <strong>@m.Map</strong> — @m.StartedAt.ToString("MMM d HH:mm")
                        </MudText>
                        <MudText Typo="Typo.caption">
                            RED @m.TeamRedRounds – @m.TeamBlueRounds BLUE
                        </MudText>
                    </MudPaper>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    @@keyframes pt-flash {
        0%   { opacity: 1; transform: translateY(0) scale(1.2); }
        100% { opacity: 0; transform: translateY(-14px) scale(1); }
    }

    .live-pts-cell {
        position: relative;
        display: inline-block;
    }

    .pts-delta {
        position: absolute;
        right: -4px;
        top: -16px;
        font-size: 0.7rem;
        font-weight: 700;
        animation: pt-flash 2.2s ease-out forwards;
        pointer-events: none;
        white-space: nowrap;
    }

    .pts-delta--pos { color: #4CAF50; }
    .pts-delta--neg { color: #f44336; }
</style>

@code {
    private Season? _activeSeason;
    private List<PlayerStanding> _standings = [];
    private List<string> _ruleNames = [];
    private List<Match> _recentMatches = [];
    private LiveMatchDto? _liveMatch;
    private PlayerStanding? _bestKd;
    private PlayerStanding? _mostDamage;
    private DuoStats? _topDuo;

    private Dictionary<string, LiveProjection> _liveProjections = new();
    private Dictionary<string, decimal> _lastLivePts = new();
    private Dictionary<string, PointDelta> _activeDeltas = new();

    private record LiveProjection(
        string Name, string Team,
        int Kills, int Deaths,
        int RoundsWon, int RoundsLost,
        decimal EstimatedPoints,
        Dictionary<string, decimal> Breakdown);

    private record PointDelta(decimal Delta, DateTime At);

    private LiveProjection? GetLiveProj(string displayName)
        => _liveProjections.TryGetValue(displayName, out var p) ? p : null;

    private PointDelta? GetActiveDelta(string displayName)
        => _activeDeltas.TryGetValue(displayName, out var d) ? d : null;

    protected override async Task OnInitializedAsync()
    {
        LiveMatch.OnMatchStateChanged += HandleMatchStateChanged;
        StandingsNotifier.StandingsChanged += HandleStandingsChanged;
        _liveMatch = LiveMatch.Current;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _activeSeason = await Db.Seasons
            .Include(s => s.Rules)
            .FirstOrDefaultAsync(s => s.IsActive);

        if (_activeSeason is not null)
        {
            try { _standings = await StandingsService.GetSeasonStandingsAsync(_activeSeason.Id); }
            catch { _standings = []; }

            _ruleNames = [.. _standings
                .SelectMany(s => s.RulesBreakdown.Keys)
                .Distinct()
                .OrderBy(k => k)];

            _bestKd = _standings
                .Where(s => s.MatchesPlayed >= 3)
                .OrderByDescending(s => s.Deaths == 0 ? (double)s.Kills : (double)s.Kills / s.Deaths)
                .FirstOrDefault();
            _mostDamage = _standings.MaxBy(s => s.DamageDealt);

            try
            {
                var duos = await DuoService.GetDuoStatsAsync(seasonId: _activeSeason.Id, topN: 1);
                _topDuo = duos.FirstOrDefault(d => d.MatchesPlayed >= 3);
            }
            catch { _topDuo = null; }
        }

        _recentMatches = await Db.Matches
            .Where(m => m.FinishedAt != null)
            .OrderByDescending(m => m.StartedAt)
            .Take(5)
            .ToListAsync();

        // Recompute projections now that we have the season loaded
        UpdateLiveProjections();
    }

    private void UpdateLiveProjections()
    {
        if (_liveMatch is null || _activeSeason is null)
        {
            _liveProjections.Clear();
            return;
        }

        var newProjections = new Dictionary<string, LiveProjection>();
        foreach (var player in _liveMatch.Players)
        {
            var roundsWon  = player.Team == "RED" ? _liveMatch.RedScore  : _liveMatch.BlueScore;
            var roundsLost = player.Team == "RED" ? _liveMatch.BlueScore : _liveMatch.RedScore;

            var dummyMatch = new Match { GameType = _liveMatch.GameType };
            var mp = new MatchPlayer
            {
                Match       = dummyMatch,
                Kills       = player.Kills,
                Deaths      = player.Deaths,
                RoundsWon   = roundsWon,
                RoundsLost  = roundsLost,
                Won         = false,
                DamageDealt = 0,
                Medals      = player.Medals
            };

            var (pts, bd) = ScoringEngine.CalculatePointsWithBreakdown(mp, _activeSeason);
            newProjections[player.Name] = new LiveProjection(
                player.Name, player.Team,
                player.Kills, player.Deaths,
                roundsWon, roundsLost, pts, bd);
        }

        // Compute deltas vs last known projected pts
        foreach (var (name, proj) in newProjections)
        {
            if (_lastLivePts.TryGetValue(name, out var prev) && prev != proj.EstimatedPoints)
            {
                var delta = new PointDelta(proj.EstimatedPoints - prev, DateTime.UtcNow);
                _activeDeltas[name] = delta;
                ScheduleDeltaCleanup(name, delta.At);
            }
            _lastLivePts[name] = proj.EstimatedPoints;
        }

        _liveProjections = newProjections;
    }

    private void ScheduleDeltaCleanup(string playerName, DateTime at)
    {
        _ = Task.Delay(2500).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_activeDeltas.TryGetValue(playerName, out var d) && d.At == at)
                _activeDeltas.Remove(playerName);
            StateHasChanged();
        }));
    }

    private void HandleMatchStateChanged()
    {
        InvokeAsync(() =>
        {
            _liveMatch = LiveMatch.Current;
            if (_liveMatch is null)
            {
                _liveProjections.Clear();
                _lastLivePts.Clear();
                _activeDeltas.Clear();
            }
            else
            {
                UpdateLiveProjections();
            }
            StateHasChanged();
        });
    }

    private void HandleStandingsChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LiveMatch.OnMatchStateChanged -= HandleMatchStateChanged;
        StandingsNotifier.StandingsChanged -= HandleStandingsChanged;
    }
}
