@page "/"
@rendermode InteractiveServer
@using QLStats.Data
@using QLStats.Data.Entities
@using QLStats.Services
@inject AppDbContext Db
@inject StandingsService StandingsService
@inject DuoAnalyticsService DuoService
@inject StandingsNotifier StandingsNotifier
@inject LiveMatchState LiveMatch
@implements IDisposable

<PageTitle>@(_activeSeason?.Name ?? "Live") — QL Stats</PageTitle>

@* ─── Live Match Header ────────────────────────────────────────────────── *@
@if (_liveMatch is not null)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid Justify="Justify.SpaceBetween" Style="align-items:center">
                <MudItem>
                    <MudText Typo="Typo.h5">@_liveMatch.Map</MudText>
                    <MudText Color="Color.Secondary">@_liveMatch.ServerName · @_liveMatch.GameType</MudText>
                </MudItem>
                <MudItem>
                    <MudText Typo="Typo.h4" Align="Align.Center">
                        <MudChip T="string" Color="Color.Error">RED @_liveMatch.RedScore</MudChip>
                        <span class="mx-2">–</span>
                        <MudChip T="string" Color="Color.Info">BLUE @_liveMatch.BlueScore</MudChip>
                    </MudText>
                    <MudText Align="Align.Center" Color="Color.Secondary">Round @_liveMatch.RoundNumber</MudText>
                </MudItem>
                <MudItem>
                    <MudText Color="Color.Secondary">Started @_liveMatch.StartedAt.ToString("HH:mm")</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@if (_activeSeason is null)
{
    <MudAlert Severity="Severity.Warning">No active season. <MudLink Href="/seasons">Create one</MudLink></MudAlert>
}
else
{
    @* ─── Season Header ──────────────────────────────────────────────────── *@
    <div class="d-flex align-center justify-space-between mb-2">
        <div>
            <MudText Typo="Typo.h4" Class="mb-0">@_activeSeason.Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_activeSeason.StartDate.ToString("MMM d, yyyy") –
                @(_activeSeason.EndDate?.ToString("MMM d, yyyy") ?? "ongoing")
            </MudText>
        </div>
        <MudButton Href="@($"/seasons/{_activeSeason.Id}")" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Analytics">Analytics</MudButton>
    </div>

    @* ─── Summary Cards ───────────────────────────────────────────────────── *@
    @if (_standings.Count > 0)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Top Scorer</MudText>
                        <MudText Typo="Typo.body1"><strong>@_standings[0].DisplayName</strong></MudText>
                        <MudText Typo="Typo.caption">@_standings[0].TotalPoints.ToString("0.##") pts</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Best K/D (min 3)</MudText>
                        <MudText Typo="Typo.body1"><strong>@(_bestKd?.DisplayName ?? "—")</strong></MudText>
                        <MudText Typo="Typo.caption">
                            @(_bestKd is not null ? (_bestKd.Deaths == 0 ? _bestKd.Kills.ToString() : ((double)_bestKd.Kills / _bestKd.Deaths).ToString("0.##")) : "—")
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Error" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Most Damage</MudText>
                        <MudText Typo="Typo.body1"><strong>@(_mostDamage?.DisplayName ?? "—")</strong></MudText>
                        <MudText Typo="Typo.caption">@(_mostDamage?.DamageDealt.ToString("N0") ?? "0")</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 d-flex align-center gap-3" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Info" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Top Duo (min 3)</MudText>
                        <MudText Typo="Typo.body1">
                            <strong>@(_topDuo is not null ? $"{_topDuo.Player1Name} & {_topDuo.Player2Name}" : "—")</strong>
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @(_topDuo is not null ? $"{_topDuo.WinRate}% WR in {_topDuo.MatchesPlayed} matches" : "—")
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ─── Standings + Kill Feed ───────────────────────────────────────────── *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="@(_liveMatch is not null ? 8 : 12)">
            <MudCard>
                <MudCardContent>
                    @if (_standings.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">No matches recorded for this season yet.</MudAlert>
                    }
                    else
                    {
                        <StandingsTable Standings="_standings"
                                        Season="_activeSeason"
                                        LiveMatch="_liveMatch"
                                        LiveProjections="_liveProjections"
                                        ActiveDeltas="_activeDeltas"
                                        LiveTrends="_liveTrends" />
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @if (_liveMatch is not null)
        {
            <MudItem xs="12" md="4">
                <MudCard Style="height:100%">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Class="mr-1" />
                                Kill Feed
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="max-height:420px;overflow-y:auto;">
                        @if (_liveMatch.KillFeed.Count == 0)
                        {
                            <MudText Color="Color.Secondary">Waiting for kills...</MudText>
                        }
                        else
                        {
                            @foreach (var k in _liveMatch.KillFeed)
                            {
                                <MudText Typo="Typo.body2" Class="mb-1">
                                    <span style="color:var(--mud-palette-success)">@k.KillerName</span>
                                    <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="mx-1" />
                                    <span style="color:var(--mud-palette-error)">@k.VictimName</span>
                                    <span class="ml-1" style="color:var(--mud-palette-text-secondary)">[@k.Weapon]</span>
                                </MudText>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @* ─── Season Matches ─────────────────────────────────────────────────── *@
    @if (_matchRows.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2">Matches</MudText>
        <MudTable Items="_matchRows" Dense="true" Hover="true" HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh Style="width:36px"></MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Map</MudTh>
                <MudTh>Score</MudTh>
                @foreach (var s in _standings)
                {
                    <MudTh Style="text-align:center">@s.DisplayName</MudTh>
                }
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Size="Size.Small"
                                   Icon="@(_expandedMatches.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ChevronRight)"
                                   OnClick="@(() => ToggleMatch(context.Id))" />
                </MudTd>
                <MudTd>@context.Date</MudTd>
                <MudTd><strong>@context.Map</strong></MudTd>
                <MudTd>
                    <span style="color:var(--mud-palette-error);font-weight:600">@context.RedScore</span>
                    <span class="mx-1">–</span>
                    <span style="color:var(--mud-palette-info);font-weight:600">@context.BlueScore</span>
                </MudTd>
                @foreach (var s in _standings)
                {
                    var p = context.Players.FirstOrDefault(x => x.Name == s.DisplayName);
                    <MudTd Style="text-align:center">
                        @if (p != null)
                        {
                            <div class="d-flex flex-column align-center">
                                <span style="color:@(p.Points > 0 ? "#4CAF50" : p.Points < 0 ? "#f44336" : "inherit");font-weight:700">
                                    @FmtPts(p.Points)
                                </span>
                                @{
                                    var rank = _standings.IndexOf(s);
                                    if (rank > 0)
                                    {
                                        var above = _standings[rank - 1];
                                        var currentGap = above.TotalPoints - s.TotalPoints;
                                        var lastGap = above.LastTotalPoints - s.LastTotalPoints;
                                        if (currentGap < lastGap)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="Color.Success" Style="font-size:0.8rem" />
                                        }
                                        else if (currentGap > lastGap)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Error" Style="font-size:0.8rem" />
                                        }
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <span style="color:var(--mud-palette-text-disabled)">—</span>
                        }
                    </MudTd>
                }
                <MudTd>
                    <MudIconButton Href="@($"/matches/{context.Id}")"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small" />
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (_expandedMatches.Contains(context.Id))
                {
                    <MudTr>
                        <MudTd colspan="6" Style="padding:4px 16px 12px 52px">
                            <MudTable Items="context.Players" Dense="true" Elevation="0" Outlined="true">
                                <HeaderContent>
                                    <MudTh>Player</MudTh>
                                    <MudTh>W/L</MudTh>
                                    <MudTh>K</MudTh>
                                    <MudTh>D</MudTh>
                                    <MudTh>K/D</MudTh>
                                    <MudTh>Dmg</MudTh>
                                    <MudTh>Dmg Taken</MudTh>
                                    <MudTh>Pts</MudTh>
                                    <MudTh>Gap</MudTh>
                                    <MudTh>Trend</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="p">
                                    <MudTd>
                                        <span style="color:@(p.Team == "RED" ? "var(--mud-palette-error)" : "var(--mud-palette-info)")">
                                            <strong>@p.Name</strong>
                                        </span>
                                    </MudTd>
                                    <MudTd>
                                        <span style="color:@(p.Won ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                                            @(p.Won ? "W" : "L")
                                        </span>
                                    </MudTd>
                                    <MudTd>@p.Kills</MudTd>
                                    <MudTd>@p.Deaths</MudTd>
                                    <MudTd>@(p.Deaths == 0 ? p.Kills.ToString() : ((double)p.Kills / p.Deaths).ToString("0.##"))</MudTd>
                                    <MudTd>@p.DamageDealt.ToString("N0")</MudTd>
                                    <MudTd>@p.DamageTaken.ToString("N0")</MudTd>
                                    <MudTd>
                                        <MudTooltip Text="@p.PointsBreakdown">
                                            <span style="color:@(p.Points > 0 ? "#4CAF50" : p.Points < 0 ? "#f44336" : "inherit");font-weight:700">
                                                @FmtPts(p.Points)
                                            </span>
                                        </MudTooltip>
                                    </MudTd>
                                    <MudTd>
                                        @{
                                            var idx = context.Players.IndexOf(p);
                                            decimal? gap = null;
                                            if (idx > 0)
                                            {
                                                var above = context.Players[idx - 1];
                                                gap = above.Points - p.Points;
                                                <span style="font-size:0.85rem;color:var(--mud-palette-text-secondary)">-@gap.Value.ToString("0.##")</span>
                                            }
                                        }
                                    </MudTd>
                                    <MudTd>
                                        @{
                                            var pIdx = context.Players.IndexOf(p);
                                            if (pIdx > 0)
                                            {
                                                var currentP = p;
                                                var aboveP = context.Players[pIdx - 1];
                                                
                                                var currentStandingsPlayer = _standings.FirstOrDefault(s => s.DisplayName == currentP.Name);
                                                var aboveStandingsPlayer = _standings.FirstOrDefault(s => s.DisplayName == aboveP.Name);

                                                if (currentStandingsPlayer != null && aboveStandingsPlayer != null)
                                                {
                                                    var currentOverallGap = aboveStandingsPlayer.TotalPoints - currentStandingsPlayer.TotalPoints;
                                                    var lastOverallGap = aboveStandingsPlayer.LastTotalPoints - currentStandingsPlayer.LastTotalPoints;
                                                    
                                                    if (currentOverallGap < lastOverallGap)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="Color.Success" />
                                                    }
                                                    else if (currentOverallGap > lastOverallGap)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Error" />
                                                    }
                                                }
                                            }
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudTd>
                    </MudTr>
                }
            </ChildRowContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
            </PagerContent>
        </MudTable>
    }
}

@code {
    private Season? _activeSeason;
    private List<PlayerStanding> _standings = [];

    private PlayerStanding? _bestKd;
    private PlayerStanding? _mostDamage;
    private DuoStats? _topDuo;

    private record MatchPlayerInfo(string Name, string Team, bool Won,
        int Kills, int Deaths, int DamageDealt, int DamageTaken,
        decimal Points, string PointsBreakdown);
    private record MatchRow(int Id, string Map, string Date, int? RedScore, int? BlueScore,
        List<MatchPlayerInfo> Players);
    private List<MatchRow> _matchRows = [];
    private HashSet<int> _expandedMatches = [];

    private LiveMatchDto? _liveMatch;
    private Dictionary<string, LiveProjection> _liveProjections = new();
    private Dictionary<string, decimal> _lastLivePts = new();
    private Dictionary<string, decimal> _lastLiveGaps = new();
    private Dictionary<string, int> _liveTrends = new();
    private Dictionary<string, PointDelta> _activeDeltas = new();

    private static string FmtPts(decimal pts) => pts > 0 ? $"+{pts:0.##}" : pts.ToString("0.##");

    private void ToggleMatch(int id)
    {
        if (!_expandedMatches.Add(id))
            _expandedMatches.Remove(id);
    }

    // ── lifecycle ──────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        LiveMatch.OnMatchStateChanged += HandleMatchStateChanged;
        StandingsNotifier.StandingsChanged += HandleStandingsChanged;
        _liveMatch = LiveMatch.Current;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _activeSeason = await Db.Seasons
            .Include(s => s.Rules)
            .FirstOrDefaultAsync(s => s.IsActive);

        if (_activeSeason is not null)
        {
            try { _standings = await StandingsService.GetSeasonStandingsAsync(_activeSeason.Id); }
            catch { _standings = []; }

            _bestKd = _standings
                .Where(s => s.MatchesPlayed >= 3)
                .OrderByDescending(s => s.Deaths == 0 ? (double)s.Kills : (double)s.Kills / s.Deaths)
                .FirstOrDefault();
            _mostDamage = _standings.MaxBy(s => s.DamageDealt);

            try
            {
                var duos = await DuoService.GetDuoStatsAsync(seasonId: _activeSeason.Id, topN: 1);
                _topDuo = duos.FirstOrDefault(d => d.MatchesPlayed >= 3);
            }
            catch { _topDuo = null; }

            await LoadMatchesAsync();
        }

        UpdateLiveProjections();
    }

    private async Task LoadMatchesAsync()
    {
        if (_activeSeason is null) return;

        var startDt = DateTime.SpecifyKind(_activeSeason.StartDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
        var endDt = _activeSeason.EndDate.HasValue
            ? DateTime.SpecifyKind(_activeSeason.EndDate.Value.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc)
            : DateTime.MaxValue;

        var matches = await Db.Matches
            .Include(m => m.MatchPlayers).ThenInclude(mp => mp.Player)
            .Where(m => m.StartedAt >= startDt && m.StartedAt < endDt
                        && m.FinishedAt != null && !m.IsArchived)
            .OrderByDescending(m => m.StartedAt)
            .ToListAsync();

        _matchRows = matches.Select(m => new MatchRow(
            Id: m.Id,
            Map: m.Map,
            Date: m.StartedAt.ToString("MM/dd HH:mm"),
            RedScore: m.TeamRedRounds,
            BlueScore: m.TeamBlueRounds,
            Players: m.MatchPlayers
                .Select(mp =>
                {
                    var (pts, bd) = ScoringEngine.CalculatePointsWithBreakdown(mp, _activeSeason!);
                    return new MatchPlayerInfo(
                        Name: mp.Player.DisplayName,
                        Team: mp.Team,
                        Won: mp.Won,
                        Kills: mp.Kills,
                        Deaths: mp.Deaths,
                        DamageDealt: mp.DamageDealt,
                        DamageTaken: mp.DamageTaken,
                        Points: pts,
                        PointsBreakdown: bd.Count > 0
                            ? string.Join(" | ", bd.Select(kv => $"{kv.Key}: {kv.Value:0.##}"))
                            : "0 pts"
                    );
                })
                .OrderByDescending(p => p.Points)
                .ToList()
        )).ToList();
    }

    // ── live match ─────────────────────────────────────────────────────────

    private void UpdateLiveProjections()
    {
        if (_liveMatch is null || _activeSeason is null)
        {
            _liveProjections.Clear();
            return;
        }

        var newProjections = new Dictionary<string, LiveProjection>();
        foreach (var player in _liveMatch.Players)
        {
            var roundsWon  = player.Team == "RED" ? _liveMatch.RedScore  : _liveMatch.BlueScore;
            var roundsLost = player.Team == "RED" ? _liveMatch.BlueScore : _liveMatch.RedScore;

            var dummyMatch = new Match { GameType = _liveMatch.GameType };
            var mp = new MatchPlayer
            {
                Match       = dummyMatch,
                Kills       = player.Kills,
                Deaths      = player.Deaths,
                RoundsWon   = roundsWon,
                RoundsLost  = roundsLost,
                Won         = false,
                DamageDealt = 0,
                Medals      = player.Medals
            };

            var (pts, bd) = ScoringEngine.CalculatePointsWithBreakdown(mp, _activeSeason);
            newProjections[player.Name] = new LiveProjection(
                player.Name, player.Team,
                player.Kills, player.Deaths,
                roundsWon, roundsLost, pts, bd);
        }

        foreach (var (name, proj) in newProjections)
        {
            if (_lastLivePts.TryGetValue(name, out var prev) && prev != proj.EstimatedPoints)
            {
                var delta = new PointDelta(proj.EstimatedPoints - prev, DateTime.UtcNow);
                _activeDeltas[name] = delta;
                ScheduleDeltaCleanup(name, delta.At);
            }
            _lastLivePts[name] = proj.EstimatedPoints;
        }

        var sorted = newProjections.Values.OrderByDescending(p => p.EstimatedPoints).ToList();
        for (int i = 1; i < sorted.Count; i++)
        {
            var p = sorted[i];
            var gap = sorted[i - 1].EstimatedPoints - p.EstimatedPoints;
            if (_lastLiveGaps.TryGetValue(p.Name, out var oldGap) && oldGap != gap)
            {
                _liveTrends[p.Name] = gap < oldGap ? -1 : 1;
            }
            _lastLiveGaps[p.Name] = gap;
        }

        _liveProjections = newProjections;
    }

    private void ScheduleDeltaCleanup(string playerName, DateTime at)
    {
        _ = Task.Delay(2500).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_activeDeltas.TryGetValue(playerName, out var d) && d.At == at)
                _activeDeltas.Remove(playerName);
            StateHasChanged();
        }));
    }

    private void HandleMatchStateChanged()
    {
        InvokeAsync(() =>
        {
            _liveMatch = LiveMatch.Current;
            if (_liveMatch is null)
            {
                _liveProjections.Clear();
                _lastLivePts.Clear();
                _activeDeltas.Clear();
            }
            else
            {
                UpdateLiveProjections();
            }
            StateHasChanged();
        });
    }

    private void HandleStandingsChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LiveMatch.OnMatchStateChanged -= HandleMatchStateChanged;
        StandingsNotifier.StandingsChanged -= HandleStandingsChanged;
    }
}
