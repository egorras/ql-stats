@page "/seasons/new"
@page "/seasons/{Id:int}/edit"
@using QLStats.Data
@using QLStats.Data.Entities
@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(Id == 0 ? "New Season" : "Edit Season") — QL Stats</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 pb-12">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/seasons"))" Color="Color.Inherit" />
            <MudText Typo="Typo.h4">@(Id == 0 ? "New Season" : "Edit Season")</MudText>
        </MudStack>

        @if (_loading)
        {
            <div class="d-flex justify-center pa-12">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudStack Spacing="6">
                    
                    <!-- Season Info Card -->
                    <MudCard Elevation="2" Class="pa-4">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Season Name" @bind-Value="_season.Name" 
                                              Required="true" RequiredError="Name is required" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudDatePicker Label="Start Date" @bind-Date="_startDate" 
                                               Required="true" RequiredError="Start date is required" 
                                               Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudDatePicker Label="End Date" @bind-Date="_endDate" Clearable="true" 
                                               Placeholder="Ongoing"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            @if (_matchCount >= 0)
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @_matchCount finished match@(_matchCount == 1 ? "" : "es") currently assigned to this season — assignment updates automatically when dates change.
                                    </MudText>
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudSwitch T="bool" @bind-Value="_season.IsActive" Label="Set as Active Season" Color="Color.Success" />
                            </MudItem>
                        </MudGrid>
                    </MudCard>

                    <!-- Rules Header -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">Scoring Rules</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRule">Add Rule</MudButton>
                    </MudStack>

                    <!-- Draggable Rules List -->
                    <MudDropContainer @ref="_dropContainer" T="ScoringRule" Items="_rules" 
                                      ItemsSelector="@((item,dropzone) => dropzone == "Rules")" 
                                      ItemDropped="ItemDropped" Class="d-flex flex-column">
                        <ChildContent>
                            <MudDropZone T="ScoringRule" Identifier="Rules" Class="d-flex flex-column gap-3" AllowReorder="true" />
                        </ChildContent>
                        <ItemRenderer Context="rule">
                            <MudPaper Elevation="0" Class="pa-3 border-solid border-1 mud-border-lines-default rounded" Style="background-color: var(--mud-palette-background-grey);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Color="Color.Default" Style="cursor: grab; opacity: 0.5" />
                                    
                                    <MudGrid Spacing="1" Class="flex-grow-1">
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="ScoringRuleType" Label="Rule Type" @bind-Value="rule.Type" 
                                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var val in Enum.GetValues<ScoringRuleType>())
                                                {
                                                    <MudSelectItem Value="@val">@GetRuleLabel(val)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudNumericField Label="Points" @bind-Value="rule.Value"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" Format="0.####" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            @if (rule.Type == ScoringRuleType.MedalMultiplier)
                                            {
                                                <MudTextField Label="Medal Type" @bind-Value="rule.MedalType"
                                                              Placeholder="e.g. Excellent"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            }
                                            else
                                            {
                                                <MudTextField Label="Game Type Filter" @bind-Value="rule.GameTypeFilter"
                                                              Placeholder="All types"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            }
                                        </MudItem>
                                    </MudGrid>

                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => RemoveRule(rule))" />
                                </MudStack>
                            </MudPaper>
                        </ItemRenderer>
                    </MudDropContainer>

                    <MudDivider />

                    <!-- Actions -->
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton OnClick="@(() => Nav.NavigateTo("/seasons"))" Variant="Variant.Text">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Size="Size.Large">Save Season</MudButton>
                    </MudStack>
                </MudStack>
            </MudForm>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private Season _season = new();
    private List<ScoringRule> _rules = new();
    private bool _loading = true;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private MudForm? _form;
    private bool _isValid;
    private MudDropContainer<ScoringRule>? _dropContainer;
    private int _matchCount = -1;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            var s = await Db.Seasons.Include(s => s.Rules).FirstOrDefaultAsync(s => s.Id == Id);
            if (s == null)
            {
                Snackbar.Add("Season not found.", Severity.Error);
                Nav.NavigateTo("/seasons");
                return;
            }
            _season = s;
            _rules = s.Rules.OrderBy(r => r.SortOrder).ToList();
            _startDate = s.StartDate.ToDateTime(TimeOnly.MinValue);
            _endDate = s.EndDate?.ToDateTime(TimeOnly.MinValue);

            var startDt = DateTime.SpecifyKind(s.StartDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
            var endDt = s.EndDate.HasValue
                ? DateTime.SpecifyKind(s.EndDate.Value.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc)
                : DateTime.MaxValue;
            _matchCount = await Db.Matches
                .Where(m => m.StartedAt >= startDt && m.StartedAt < endDt && m.FinishedAt != null)
                .CountAsync();
        }
        else
        {
            var lastSeason = await Db.Seasons.Include(s => s.Rules).OrderByDescending(s => s.StartDate).FirstOrDefaultAsync();
            _season = new Season { StartDate = DateOnly.FromDateTime(DateTime.Today), IsActive = true };
            _startDate = DateTime.Today;

            if (lastSeason != null)
            {
                _rules = lastSeason.Rules.OrderBy(r => r.SortOrder).Select(r => new ScoringRule
                {
                    Type = r.Type,
                    Value = r.Value,
                    Threshold = r.Threshold,
                    GameTypeFilter = r.GameTypeFilter,
                    MedalType = r.MedalType,
                    SortOrder = r.SortOrder
                }).ToList();
            }
            else
            {
                _rules = new List<ScoringRule>
                {
                    new() { Type = ScoringRuleType.KillsMultiplier,    Value = 1,      SortOrder = 0 },
                    new() { Type = ScoringRuleType.SuicidesMultiplier, Value = -1,     SortOrder = 1 },
                    new() { Type = ScoringRuleType.WinMultiplier,      Value = 5,      SortOrder = 2 },
                    new() { Type = ScoringRuleType.RoundsWonMultiplier,Value = 0.5m,   SortOrder = 3 },
                    new() { Type = ScoringRuleType.DamageMultiplier,   Value = 0.01m,  SortOrder = 4 }
                };
            }
        }
        _loading = false;
    }

    private void AddRule()
    {
        var nextOrder = _rules.Count > 0 ? _rules.Max(r => r.SortOrder) + 1 : 0;
        _rules.Add(new ScoringRule { Type = ScoringRuleType.KillsMultiplier, Value = 1, SortOrder = nextOrder });
        _dropContainer?.Refresh();
    }

    private void RemoveRule(ScoringRule rule)
    {
        _rules.Remove(rule);
        ReorderRules();
        _dropContainer?.Refresh();
    }

    private void ItemDropped(MudItemDropInfo<ScoringRule> dropInfo)
    {
        if (dropInfo.Item == null) return;
        
        _rules.Remove(dropInfo.Item);
        var index = dropInfo.IndexInZone;
        if (index < 0) index = 0;
        if (index >= _rules.Count) _rules.Add(dropInfo.Item);
        else _rules.Insert(index, dropInfo.Item);
        
        ReorderRules();
        _dropContainer?.Refresh();
    }

    private void ReorderRules()
    {
        for (int i = 0; i < _rules.Count; i++)
        {
            _rules[i].SortOrder = i;
        }
    }

    private string GetRuleLabel(ScoringRuleType type) => type switch
    {
        ScoringRuleType.KillsMultiplier     => "Kills Multiplier",
        ScoringRuleType.SuicidesMultiplier  => "Suicides Multiplier",
        ScoringRuleType.DamageMultiplier    => "Damage Multiplier",
        ScoringRuleType.WinMultiplier       => "Win Bonus",
        ScoringRuleType.RoundsWonMultiplier => "Rounds Won Multiplier",
        ScoringRuleType.MedalMultiplier     => "Medal Multiplier",
        _                                   => type.ToString()
    };

    private async Task SaveAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_isValid) return;
        }

        _season.StartDate = _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : DateOnly.FromDateTime(DateTime.Today);
        _season.EndDate = _endDate.HasValue ? DateOnly.FromDateTime(_endDate.Value) : null;

        ReorderRules();

        if (Id == 0)
        {
            _season.Rules = _rules;
            Db.Seasons.Add(_season);
        }
        else
        {
            var existing = await Db.Seasons.Include(s => s.Rules).FirstOrDefaultAsync(s => s.Id == Id);
            if (existing != null)
            {
                existing.Name = _season.Name;
                existing.StartDate = _season.StartDate;
                existing.EndDate = _season.EndDate;
                existing.IsActive = _season.IsActive;

                existing.Rules.Clear();
                foreach (var r in _rules)
                {
                    existing.Rules.Add(new ScoringRule
                    {
                        Type = r.Type,
                        Value = r.Value,
                        Threshold = r.Threshold,
                        GameTypeFilter = r.GameTypeFilter,
                        MedalType = r.MedalType,
                        SortOrder = r.SortOrder
                    });
                }
            }
        }

        if (_season.IsActive)
        {
            var others = await Db.Seasons
                .Where(s => s.IsActive && s.Id != Id)
                .ToListAsync();
            foreach (var other in others)
                other.IsActive = false;
        }

        await Db.SaveChangesAsync();
        Snackbar.Add("Season saved.", Severity.Success);
        Nav.NavigateTo("/seasons");
    }
}
