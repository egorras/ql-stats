@page "/sessions"
@rendermode InteractiveServer
@using QLStats.Data
@using QLStats.Data.Entities
@inject AppDbContext Db
@inject ISnackbar Snackbar

<PageTitle>Sessions — QL Stats</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Sessions</MudText>

<MudTable Items="_sessions" Dense="true" Hover="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Season</MudTh>
        <MudTh>Matches</MudTh>
        <MudTh>Notes</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.SessionDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>
            @if (_editingSessionId == context.Id)
            {
                <MudSelect T="int?" @bind-Value="_editSeasonId" Dense="true">
                    <MudSelectItem T="int?" Value="null">— None —</MudSelectItem>
                    @foreach (var s in _seasons)
                    {
                        <MudSelectItem T="int?" Value="s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                @(context.Season?.Name ?? "—")
            }
        </MudTd>
        <MudTd>
            <MudLink Href="@($"/matches?session={context.Id}")">@context.Matches.Count</MudLink>
        </MudTd>
        <MudTd>
            @if (_editingSessionId == context.Id)
            {
                <MudTextField @bind-Value="_editNotes" Margin="Margin.Dense" />
            }
            else
            {
                @(context.Notes ?? "")
            }
        </MudTd>
        <MudTd>
            @if (_editingSessionId == context.Id)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success" Size="Size.Small"
                    OnClick="@(() => SaveSessionAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                    OnClick="@CancelEdit" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                    OnClick="@(() => StartEdit(context))" />
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<GameSession> _sessions = [];
    private List<Season> _seasons = [];
    private bool _loading = true;
    private int _editingSessionId;
    private int? _editSeasonId;
    private string? _editNotes;

    protected override async Task OnInitializedAsync()
    {
        _seasons = await Db.Seasons.OrderByDescending(s => s.IsActive).ToListAsync();
        _sessions = await Db.GameSessions
            .Include(s => s.Season)
            .Include(s => s.Matches)
            .OrderByDescending(s => s.SessionDate)
            .ToListAsync();
        _loading = false;
    }

    private void StartEdit(GameSession s)
    {
        _editingSessionId = s.Id;
        _editSeasonId = s.SeasonId;
        _editNotes = s.Notes;
    }

    private void CancelEdit() => _editingSessionId = 0;

    private async Task SaveSessionAsync(GameSession s)
    {
        s.SeasonId = _editSeasonId;
        s.Season = _editSeasonId.HasValue ? _seasons.FirstOrDefault(x => x.Id == _editSeasonId) : null;
        s.Notes = _editNotes;
        await Db.SaveChangesAsync();
        _editingSessionId = 0;
        Snackbar.Add("Session updated.", Severity.Success);
    }
}
